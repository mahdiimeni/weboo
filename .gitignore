# Dependencies
node_modules/

# E2E fixture build artifacts
.next/
out/

# TypeScript incremental cache
tsconfig.tsbuildinfo
# stray per-file tsc emits (build:ext only ever writes extension/shared/)
src/**/*.js

# WXT (Phase 6) build artifacts
.output/
.wxt/
# workspace meta (agent plans/scratch) — not extension content
.hermes/

# superdesign scratch (skill temp HTML)
.superdesign/tmp/

