{
  "manifest_version": 3,
  "name": "وبو — هایلایت و یادداشت محلی",
  "short_name": "وبو",
  "version": "0.12.1",
  "description": "هایلایت مقالات وب با ۵ رنگ، یادداشت روی هر هایلایت، ذخیره‌سازی ۱۰۰٪ محلی روی دستگاه شما و بک‌آپ/بازیابی JSON — بدون سرور، بدون حساب کاربری، بدون اشتراک.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": [
        "shared/constants.js",
        "shared/backends/chrome-storage.js",
        "shared/url.js",
        "shared/utils.js",
        "shared/format.js",
        "shared/detect-dir.js",
        "shared/clipboard.js",
        "shared/tags.js",
        "shared/textindex.js",
        "shared/domwrap.js",
      "shared/anchor.js",
        "shared/ui/base.js",
        "shared/ui/toast.js",
        "shared/ui/toolbar.js",
        "shared/ui/popover.js",
        "shared/store.js",
        "shared/runtime-bridge.js",
        "shared/highlighter.js",
        "shared/message-guard.js",
        "content/favicon.js",
        "content/content.js"
      ],
      "css": ["content/mark-style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "وبو",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "commands": {
    "highlight-selection": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "MacCtrl+Shift+H"
      },
      "description": "هایلایت سریع متن انتخاب‌شده با رنگ پیش‌فرض"
    }
  },
  "minimum_chrome_version": "102"
}
