{
  "name": "web-highlighter",
  "version": "0.6.7",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:ext": "tsc -p tsconfig.extension.json",
    "test": "bun run build:ext && bun test tests/unit",
    "zip": "bun run build:ext && node scripts/build-zip.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:wxt": "wxt build && node scripts/wxt-parity.mjs",
    "harness": "node tests/e2e/build-dashboard-harness.mjs && node tests/e2e/build-popup-harness.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "wxt": "^0.21.4"
  }
}
